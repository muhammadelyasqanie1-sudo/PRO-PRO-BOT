BOT_TOKEN=123456:replace-with-token-from-BotFather
OWNER_ID=123456789
# On Railway: attach a Volume mounted at /data and set DB_PATH=/data/bot.db
DB_PATH=data/bot.db
LOG_LEVEL=INFO
BROADCAST_RATE=20

# Set this to your Railway public HTTPS domain to enable the Telegram Mini App.
# Example: https://your-service.up.railway.app
MINI_APP_URL=
WEB_HOST=0.0.0.0
# Railway injects PORT automatically; WEB_PORT is used locally if PORT is absent.
WEB_PORT=8080

# Augestel IPRN API (optional; polling disabled if API key is empty)
AUGESTEL_API_BASE=https://augestel.com/api/v1/iprn
AUGESTEL_API_KEY=put-your-Augestel-API-key-here
AUGESTEL_MESSAGES_PATH=/messages
